# ====== EIRAA AI – cấu hình (đổi tên file thành .env) ======
COMPANY_NAME=Công ty ABC

# Bot Telegram cho sếp – lấy từ @BotFather
TELEGRAM_BOT_TOKEN=
# (Không bắt buộc) Thêm ID Telegram người nhận báo cáo, cách nhau dấu phẩy. Người đầu tiên bấm Start bot tự thành sếp
BOSS_TELEGRAM_IDS=

# ChatGPT – lấy tại platform.openai.com/api-keys. Để trống = chế độ cơ bản
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Giờ tự gửi tổng hợp cho sếp / nhắc ai chưa nộp (T2–T7). Để trống = tắt
DAILY_REPORT_TIME=17:30
REMIND_TIME=16:30

PORT=8000

# Lần đầu chạy (chưa có nhân viên) tự nạp dữ liệu demo. Đặt 0 để tắt
DEMO_DATA=1
